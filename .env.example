# Copy to .env. Never commit real credentials.
DATABASE_URL="postgresql://status:CHANGE_ME@localhost:5432/statuspage"
# Public origin, including scheme. Required in production; must match the browser URL.
APP_URL="http://localhost:3000"
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Remove SETUP_TOKEN after creating the first owner. Setup also closes whenever any account exists.
SETUP_TOKEN=""
# Required for 2FA. Back up this value with the database; keep it stable across deployments.
AUTH_ENCRYPTION_KEY=""
# Used by compose.db.yaml for the bundled database. Use a unique random password.
POSTGRES_PASSWORD=""
